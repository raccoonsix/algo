# .env.example — placeholders ONLY (R-02, FR-SEC-001)
#
# Copy this file to `.env` and fill in real values locally.
# `.env` is gitignored and MUST never be committed.
# NEVER put real secrets in this file, in code, tests, docs, logs, or LLM prompts.
#
# Variable names are defined in docs/ARCHITECTURE.md §7 and docs/DATA_SPEC.md §10.

# Runtime environment (dev | prod). See ARCHITECTURE §7.
ATR_ENV=dev

# LLM provider credentials (see DATA_SPEC §10: llm.base_url_env, llm.api_key_env).
# Public market data only; no trade-capable keys exist in v1 (R-01).
LLM_API_KEY=replace-me
LLM_BASE_URL=https://replace-me.example

# Optional exchange REST base override (ARCHITECTURE §7). Public endpoints only.
EXCHANGE_API_BASE=
